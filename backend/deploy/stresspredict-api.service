[Unit]
Description=StressPredict assessment API
After=network.target

[Service]
User=stresspredict
WorkingDirectory=/opt/stresspredict/backend
# Optional overrides, e.g. STRESS_LOW_MAX=5 and STRESS_MODERATE_MAX=10
EnvironmentFile=-/etc/stresspredict.env
# Bodies are never logged by uvicorn; keep it that way. Behind CloudFront, so bind to all
# interfaces and rely on the security group (CloudFront prefix list only) to restrict access.
ExecStart=/opt/stresspredict/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
